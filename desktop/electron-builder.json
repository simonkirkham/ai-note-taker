{
  "appId": "com.simonkirkham.ainotetaker",
  "productName": "AI Note Taker",
  "artifactName": "AINoteTaker-Setup-${version}-${arch}.${ext}",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "web-dist/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "resources/whisper",
      "to": "whisper"
    }
  ],
  "asar": true,
  "publish": [
    {
      "provider": "generic",
      "url": "https://github.com/simonkirkham/ai-note-taker/releases/download/desktop-latest",
      "channel": "latest"
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64", "arm64"]
      }
    ]
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "createDesktopShortcut": true,
    "shortcutName": "AI Note Taker"
  }
}
