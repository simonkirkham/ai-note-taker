{
  "appId": "com.simonkirkham.ainotetaker",
  "productName": "AI Note Taker",
  "artifactName": "AINoteTaker-Setup-${version}-${arch}.${ext}",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "web-dist/**/*",
    "package.json"
  ],
  "asar": true,
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64", "arm64"]
      }
    ]
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "createDesktopShortcut": true,
    "shortcutName": "AI Note Taker"
  }
}
