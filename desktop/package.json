{
  "name": "ai-note-taker-desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Windows desktop shell (Electron) for AI Note Taker — bundle-shell: ships the compiled web/ frontend, calls the live prod API.",
  "main": "dist/main.js",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "build:main": "tsc -p tsconfig.json",
    "build": "npm run build:web && npm run build:main",
    "start": "electron .",
    "test:e2e": "playwright test",
    "test:server": "playwright test server.spec.ts",
    "package": "echo 'TODO(31-C): electron-builder --win' && exit 1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2"
  }
}
