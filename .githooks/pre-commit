#!/bin/sh
set -e

echo "→ build (warnings as errors)..."
dotnet build ai-note-taker.sln -p:TreatWarningsAsErrors=true --nologo -v quiet

echo "→ frontend lint..."
npm --prefix web run lint

echo "→ frontend typecheck..."
npm --prefix web exec -- tsc -p web/tsconfig.app.json --noEmit

echo "→ component tests..."
npm --prefix web run test

echo "→ domain specs..."
dotnet test tests/Domain.Specs/Domain.Specs.csproj --nologo -v quiet

echo "→ API integration tests..."
dotnet test tests/Api.Integration/Api.Integration.csproj --nologo -v quiet

echo "→ infra assertions..."
dotnet test tests/Infrastructure.Assertions/Infrastructure.Assertions.csproj --nologo -v quiet

echo "✓ pre-commit checks passed"
