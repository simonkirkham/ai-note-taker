#!/bin/sh
set -e

# FAST checks only. Anything that takes more than a few seconds lives in CI.
#
# Why: the full gate (build + 3 dotnet test runs + lint + typecheck + vitest) took
# ~10-15 minutes per commit, while PR CI runs the same checks in ~3. The hook was four
# times slower than the thing it was protecting against, so it was cheaper to push and
# let CI answer. It also only ever ran on a clone that had run
# `git config core.hooksPath .githooks` — so it was never the real gate anyway.
#
# pr.yml covers all of it and more: domain specs (:52), API integration (:55), infra
# assertions (:58), cdk synth (:78), lint (:97), BOTH typechecks (:101, :105) and vitest
# (:109), plus EventStore.Integration (:174) which this hook never ran. Nothing merges
# without those passing.
#
# What is left below runs in about a second, and each item is here because CI does not
# cover it cheaply or at all.

staged=$(git diff --cached --name-only --diff-filter=ACMR)

# Tracking-doc id check. Catches the `merge=union` failure mode (two branches editing the
# same row, both copies kept) and a duplicate id claimed on another session's branch.
# Pure grep, no network, instant.
if echo "$staged" | grep -Eq '^docs/(phases/phase-(bugs|minor-changes)\.md|technical-improvements\.md|roadmap\.md)$'; then
  echo "→ tracking-doc ids..."
  ./scripts/check-doc-ids.sh
fi

# Workflow lint. A broken workflow file fails as an unparseable run rather than a red
# check, which is invisible until someone looks at the Actions tab (TI-69: 162 push red
# X's, nobody noticed). LINT_WORKFLOWS_OPTIONAL lets a machine that cannot fetch the
# actionlint binary print a loud skip rather than block; CI has no such escape.
#
# Invoked via `bash` because this repo lives on a Windows/WSL mount with
# core.fileMode=false, so `./scripts/...` is "Permission denied" on a clone with a real
# filesystem.
if echo "$staged" | grep -Eq '^\.github/(workflows|actions)/'; then
  echo "→ workflow lint..."
  LINT_WORKFLOWS_OPTIONAL=1 bash ./scripts/lint-workflows.sh
fi

echo "✓ pre-commit checks passed (build/test gate is in CI)"
